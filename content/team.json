{
  "registration_url": "https://docs.qq.com/form/page/DRGptdHB1SERpSEx4",
  "groups": [
    {
      "slug": "mechanics",
      "name": "机械组",
      "tagline": "机器人的骨骼与躯体",
      "intro": "从结构方案到整机装配，机械组把赛场任务转化为可制造、可运动的机器人结构。",
      "tasks": [
        "使用 Fusion、SolidWorks 等工具完成三维建模与结构设计。",
        "开展力学仿真，结合加工条件优化机构与零件。",
        "参与零件加工、3D 打印与整机装配，在测试中持续改进。"
      ],
      "fit": "适合对机械工程、车辆工程、机器人工程、力学感兴趣的同学。欢迎空间想象力好、愿意动手验证想法的你。"
    },
    {
      "slug": "hardware",
      "name": "硬件组",
      "tagline": "机器人的心脏与血脉",
      "intro": "从电路原理图到可靠的电路板，硬件组为机器人建立稳定的供电、驱动与信号连接。",
      "tasks": [
        "设计电路原理图，使用嘉立创 EDA 等工具完成 PCB 布局。",
        "进行元器件选型、电路焊接与硬件调试。",
        "与机械、电控组协作，验证电路板在整机运行中的稳定性。"
      ],
      "fit": "适合对电子信息、电气工程、自动化、测控感兴趣的同学。需要细心、耐心，以及对电路和动手制作的热爱。"
    },
    {
      "slug": "control",
      "name": "电控组",
      "tagline": "机器人的小脑与神经",
      "intro": "让机器人从“装好”走向“走稳”。电控组连接底层驱动、运动控制与整机调试，将控制策略落实为赛场动作。",
      "tasks": [
        "基于 STM32 使用 C 语言编写底层驱动，并与硬件系统联调。",
        "开发运动控制与多腿步态，探索仿生足式机器人的稳定运动。",
        "开展仿真验证与整机测试，优化控制效果和运行稳定性。"
      ],
      "fit": "适合对自动化、电子信息、计算机、通信工程感兴趣的同学。欢迎逻辑清晰、愿意反复调试并主动学习的你。"
    },
    {
      "slug": "vision",
      "name": "视觉组",
      "tagline": "机器人的双眼与感知",
      "intro": "从图像中识别目标、理解位置，让机器人获得感知赛场的能力。视觉组将识别与定位结果转化为可供控制系统使用的信息。",
      "tasks": [
        "开展图像处理、目标识别与追踪。",
        "使用深度相机获取和解析数据，探索上位机算法部署。",
        "结合视觉定位与 SLAM 等技术，为机器人感知和自主运行提供支持。",
        "使用 ROS 组织视觉与感知模块，完成节点通信和系统集成。"
      ],
      "fit": "适合对计算机科学、软件工程、人工智能、数据科学感兴趣的同学。有 C++、Python 或 MATLAB 基础，以及线性代数、概率统计知识会有帮助。"
    },
    {
      "slug": "publicity",
      "name": "宣运组",
      "tagline": "战队的大管家与传声筒",
      "intro": "记录每一次奔赴赛场，也照顾每一段幕后协作。宣运组将赛事事务、内容创作和团队文化连接起来。",
      "tasks": [
        "协调赛事财务、物料采购与参赛事务，支持战队日常运转。",
        "开展公众号推文排版、视频剪辑与日常摄影，记录备赛和比赛。",
        "策划团队文化活动与宣传内容，让更多人认识 GSing。"
      ],
      "fit": "专业不限。欢迎细心负责、善于协作，有文案、设计、摄影或剪辑兴趣的同学。"
    }
  ],
